---
import { productsData } from '../content/data/barberData';
import { Sparkles, PackageCheck } from 'lucide-astro';
import SwiperComponent from './swiper/SwiperComponent.astro';
import { SwiperSlide } from "astro-swiper";
import type { SwiperI } from './swiper/swiperType';


const toolsSwiperOptions = {
  slidesPerView: 1,
  spaceBetween: 10,
  grid: {
    fill:"row",
    rows: 2,

  },
  loop: false,
  autoplay: {
    delay: 1500,
    disableOnInteraction: false,
    pauseOnMouseEnter: true,
  },
  breakpoints: {
    450: {
      // sm
      slidesPerView:1,
      spaceBetween: 10
    },
    // 540: {
    //     // sm
    //     slidesPerView: 4,
    //     spaceBetween: 10,
    // },
    640: {
      // sm
      slidesPerView: 2,
      spaceBetween: 10,
    },
    768: {
      // md
      slidesPerView: 2,
      spaceBetween: 24,
    },
    // 860: {
    //   // sm
    //   slidesPerView: 4,
    //   spaceBetween: 10,
    // // },
    // 1024: {
    //   // lg
    //   slidesPerView: 2,
    //   spaceBetween: 25,
    // },
    1280: {
      // xl
      slidesPerView: 3,
      spaceBetween: 25,
    },
    // 1536: {
    //     // 2xl
    //     slidesPerView: 5,
    //     spaceBetween: 48,
    // },
  },
} as SwiperI;

---

 

<section id="productos" class="py-24 sm:py-32 bg-dark border-t border-quaternary relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Encabezado de Productos Sin Badge -->
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
      <h2 class="font-heading text-3xl sm:text-5xl font-extrabold text-light tracking-tight uppercase">
        Línea de <span class="text-accent">Productos</span>
      </h2>
      <p class="mt-4 text-sm sm:text-base text-light/70 leading-relaxed font-light">
        Formulaciones de grado profesional seleccionadas por nuestros Master Barbers para mantener tu cuidado personal en casa.
      </p>
    </div>

    <!-- Grid de Tarjetas de Productos  -->
     <SwiperComponent
      optionsSwiper={toolsSwiperOptions}
      classSwiperUser={``}
      classSwiperWrapperUser="pb-[45px]"
      paginationUser={true}
    >
    <!-- <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8"> -->
      {productsData.map((product) => {
        // Cálculo del precio final con descuento si aplica
        const hasDiscount = typeof product.discountPercent === 'number' && product.discountPercent > 0;
        const finalPrice = hasDiscount
          ? (product.price * (1 - (product.discountPercent || 0) / 100)).toFixed(2)
          : product.price.toFixed(2);

        return (
          <SwiperSlide>
            <article class="bg-tertiary border border-quaternary hover:border-accent transition-all duration-300 p-6 flex flex-col justify-between group relative">
              
              <div class="grid grid-cols-2 sm:grid-cols-1 md:grid-cols-2  gap-3">
                {/* imagen */}
                <div>
                  <!-- Imagen del Producto con Overlay y Badges -->
                  <div class="relative h-64 w-full bg-dark overflow-hidden mb-6 border border-quaternary/70">
                    <img
                      src={product.image}
                      alt={product.title}
                      class="w-full h-full object-cover object-center opacity-85 group-hover:scale-105 group-hover:opacity-100 transition-all duration-500"
                      loading="lazy"
                    />

                    <div class="absolute inset-0 bg-linear-to-t from-dark/80 via-transparent to-transparent"></div>

                    <!-- Badge de Descuento Porcentual si aplica -->
                    {hasDiscount && (
                      <div class="absolute top-3 left-3 bg-accent text-dark font-mono font-bold text-[10px] uppercase tracking-widest px-2.5 py-1 shadow-md">
                        -{product.discountPercent}% OFF
                      </div>
                    )}

                    <!-- Badge Especial / Destacado -->
                    {product.badge && (
                      <div class="absolute top-3 right-3 bg-dark/90 border border-quaternary text-accent font-mono font-bold text-[9px] uppercase tracking-wider px-2 py-0.5">
                        {product.badge}
                      </div>
                    )}

                    {product.volume && (
                      <div class="absolute bottom-3 right-3 text-[10px] font-mono text-light/70 bg-dark/80 px-2 py-0.5 border border-quaternary">
                        {product.volume}
                      </div>
                    )}
                  </div>

                </div>
                {/* metadata */}
                <div>
                    <!-- Categoría -->
                    <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-accent block mb-1">
                      {product.category}
                    </span>

                    <!-- Título del Producto -->
                    <h3 class="font-heading text-lg font-bold text-light uppercase tracking-wide group-hover:text-accent transition-colors">
                      {product.title}
                    </h3>

                    <!-- Descripción -->
                    <p class="mt-2 text-xs sm:text-sm text-light/70 leading-relaxed font-light">
                      {product.description}
                    </p>

                </div>

              </div>

              <!-- Precios y Estado de Disponibilidad -->
              <div class=" pt-5 border-t border-quaternary flex items-end justify-between gap-4">
                <div>
                  <span class="text-[9px] font-mono uppercase tracking-widest text-light/40 block">
                    Precio Exclusivo
                  </span>

                  <div class="flex items-baseline gap-2">
                    {hasDiscount ? (
                      <>
                        <span class="font-heading text-2xl font-black text-accent font-mono">
                          ${finalPrice}
                        </span>
                        <span class="text-xs text-light/40 line-through font-mono">
                          ${product.price.toFixed(2)}
                        </span>
                      </>
                    ) : (
                      <span class="font-heading text-2xl font-black text-light font-mono">
                        ${finalPrice}
                      </span>
                    )}
                    <span class="text-[10px] text-light/50 font-mono font-medium">USD</span>
                  </div>
                </div>

                <!-- Indicador de Disponibilidad en Studio -->
                <div class="text-right">
                  <span class="inline-flex items-center gap-1 text-[10px] font-mono font-semibold text-accent/90 bg-dark border border-quaternary px-2.5 py-1">
                    <PackageCheck class="w-3 h-3 text-accent" />
                    En Studio
                  </span>
                </div>
              </div>

            </article>

          </SwiperSlide>
        );
      })}
    <!-- </div> -->
    </SwiperComponent>
  </div>
</section>
