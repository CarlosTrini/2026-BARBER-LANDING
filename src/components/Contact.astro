---
import { contactData } from "../content/data/barberData";
import BookingForm from "./BookingForm";
import {
  MapPin,
  Phone,
  Clock,
  Mail,
  Navigation,
  MessageCircle,
  Car,
  Coffee,
  CheckCircle2,
} from "lucide-astro";
---

<section
  id="contacto"
  class="py-24 sm:py-32 bg-dark border-t border-quaternary relative overflow-hidden"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Encabezado de la Sección Geométrico Sin Badge -->
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
      <h2
        class="font-heading text-3xl sm:text-5xl font-extrabold text-light tracking-tight uppercase"
      >
        Reserva Tu Cita <br /> &amp; <span class="text-accent">Visítanos</span>
      </h2>
      <p
        class="mt-4 text-sm sm:text-base text-light/70 leading-relaxed font-light"
      >
        Asegura tu butaca con anticipación para disfrutar de una atención
        individual y sin tiempos de espera.
      </p>
    </div>

    <!-- Grid Dividido: Lado A (SEO Estático) y Lado B (React Form)  -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      <!-- LADO A: Información de Ubicación, Horarios y Contacto (Astro Estático) -->
      <div class="lg:col-span-5 space-y-6">
        <div class="bg-tertiary border border-quaternary p-6 sm:p-8 space-y-5">
          <h3
            class="text-xs font-mono font-bold uppercase tracking-[0.25em] text-accent flex items-center gap-2"
          >
            <MapPin class="w-4 h-4 text-accent" />
            Ubicación del Studio
          </h3>

          <div class="space-y-1.5 text-sm text-light/80">
            <p class="font-heading font-bold text-base text-light uppercase">
              {contactData.address}
            </p>
            <p class="text-light/70 font-light">
              {contactData.neighborhood}, {contactData.city}
            </p>
            <p class="text-[11px] text-light/45 font-mono">
              Entre Calderón de la Barca y Lafontaine • Polanco
            </p>
          </div>

          <!-- Canales Rápidos -->
          <div class="pt-4 border-t border-quaternary space-y-3">
            <div class="flex items-center gap-3">
              <div
                class="w-9 h-9 bg-dark border border-quaternary flex items-center justify-center text-accent shrink-0"
              >
                <Phone class="w-4 h-4" />
              </div>
              <div>
                <span
                  class="text-[9px] uppercase font-mono font-bold text-light/50 block"
                  >Llamadas Directas</span
                >
                <a
                  href={`tel:${contactData.phone}`}
                  class="text-sm font-bold text-light hover:text-accent font-mono transition-colors"
                >
                  {contactData.phoneFormatted}
                </a>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <div
                class="w-9 h-9 bg-dark border border-quaternary flex items-center justify-center text-accent shrink-0"
              >
                <MessageCircle class="w-4 h-4" />
              </div>
              <div>
                <span
                  class="text-[9px] uppercase font-mono font-bold text-light/50 block"
                  >WhatsApp Concierge</span
                >
                <a
                  href={contactData.whatsappUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm font-bold text-accent hover:underline transition-colors font-mono"
                >
                  Enviar mensaje directo
                </a>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <div
                class="w-9 h-9 bg-dark border border-quaternary flex items-center justify-center text-accent shrink-0"
              >
                <Mail class="w-4 h-4" />
              </div>
              <div>
                <span
                  class="text-[9px] uppercase font-mono font-bold text-light/50 block"
                  >Correo Oficial</span
                >
                <a
                  href={`mailto:${contactData.email}`}
                  class="text-sm font-medium text-light/90 hover:text-accent transition-colors font-mono"
                >
                  {contactData.email}
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Tarjeta de Horarios Oficiales Geométrica -->
        <div class="bg-tertiary border border-quaternary p-6 sm:p-8 space-y-4">
          <h3
            class="text-xs font-mono font-bold uppercase tracking-[0.25em] text-accent flex items-center gap-2"
          >
            <Clock class="w-4 h-4 text-accent" />
            Horarios de Atención
          </h3>

          <div class="space-y-2 text-sm">
            {
              contactData.schedule.map((item) => (
                <div class="flex items-center justify-between py-2 border-b border-quaternary/40 last:border-none">
                  <span class="font-normal text-light/80 text-xs sm:text-sm ">
                    {item.days}
                  </span>
                  <span class="font-mono text-accent font-bold text-xs sm:text-sm bg-dark border border-quaternary px-2.5 py-1">
                    {item.hours}
                  </span>
                </div>
              ))
            }
          </div>

          <p
            class="text-[11px] text-light/50 pt-2 flex items-center gap-1.5 font-mono"
          >
            <CheckCircle2 class="w-3.5 h-3.5 text-accent shrink-0" />
            Atención preferencial mediante reserva previa.
          </p>
        </div>

        <!-- Amenidades del Studio Geométricas -->
        <div class="grid grid-cols-2 gap-3 text-xs text-light/80 font-light">
          <div
            class="p-3 bg-tertiary border border-quaternary flex items-center gap-2.5"
          >
            <Car class="w-4 h-4 text-accent shrink-0" />
            <span>Valet Parking sin costo</span>
          </div>
          <div
            class="p-3 bg-tertiary border border-quaternary flex items-center gap-2.5"
          >
            <Coffee class="w-4 h-4 text-accent shrink-0" />
            <span>Café y whisky de cortesía</span>
          </div>
        </div>

        <!-- Mapa Abstracto / Tarjeta con Enlace a Google Maps -->
        <div
          class="bg-tertiary/70 border border-quaternary p-5 flex items-center justify-between gap-4"
        >
          <div class="flex items-center gap-3">
            <div
              class="w-10 h-10 bg-dark border border-quaternary flex items-center justify-center text-accent shrink-0"
            >
              <Navigation class="w-5 h-5" />
            </div>
            <div>
              <p class="text-xs font-bold text-light uppercase font-heading">
                ¿Cómo llegar al Studio?
              </p>
              <p class="text-[11px] text-light/60 font-mono">
                Abrir mapa en Google Maps / Waze
              </p>
            </div>
          </div>

          <a
            href={contactData.mapUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 text-xs font-bold uppercase tracking-widest bg-dark border border-quaternary text-accent hover:border-accent hover:bg-quaternary transition-colors shrink-0"
          >
            Ver Mapa
          </a>
        </div>
      </div>

      <!-- LADO B: Formulario Interactivo en React (Geométrico) -->
      <div class="lg:col-span-7">
        <BookingForm client:visible />
      </div>
    </div>
  </div>
</section>
