---
import { servicesData } from '../content/data/barberData';
import { Clock, Check, Crown, ArrowRight, ShieldCheck } from 'lucide-astro';
---

<section id="servicios" class="py-24 sm:py-32 bg-secondary border-t border-quaternary relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Encabezado de Sección -->
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
      <h2 class="font-heading text-3xl sm:text-5xl font-extrabold text-light tracking-tight uppercase">
        Servicios &amp; <span class="text-accent">Tarifas</span>
      </h2>
      <p class="mt-4 text-sm sm:text-base text-light/70 leading-relaxed font-light">
        Cada sesión es una experiencia individualizada. Sin prisas, con productos premium y técnica de visagismo.
      </p>
    </div>

    <!-- Grid de Tarjetas de Servicios Geométricas -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {servicesData.map((service) => (
        <article
          class={`relative bg-tertiary border transition-all duration-300 p-7 sm:p-8 flex flex-col justify-between group hover:-translate-y-1 hover:shadow-2xl hover:shadow-dark ${
            service.popular
              ? 'border-accent ring-1 ring-accent/30'
              : 'border-quaternary hover:border-accent'
          }`}
        >
          <!-- Badge Destacado Geométrico si es popular -->
          {service.popular && (
            <div class="absolute -top-3.5 right-6 inline-flex items-center gap-1.5 px-3 py-1 bg-accent text-dark text-[10px] font-black uppercase tracking-widest shadow-md">
              <Crown class="w-3 h-3" />
              Recomendado Studio
            </div>
          )}

          <div>
            <!-- Categoría y Duración -->
            <div class="flex items-center justify-between gap-4 mb-4">
              <span class="text-[10px] font-bold tracking-[0.2em] uppercase text-accent bg-dark border border-quaternary px-2.5 py-1 font-mono">
                {service.category}
              </span>
              <div class="flex items-center gap-1.5 text-xs text-light/60 font-mono">
                <Clock class="w-3.5 h-3.5 text-accent" />
                <span>{service.duration}</span>
              </div>
            </div>

            <!-- Título del Servicio -->
            <h3 class="font-heading text-xl sm:text-2xl font-bold text-light group-hover:text-accent transition-colors duration-200">
              {service.name}
            </h3>

            <!-- Tagline -->
            <p class="text-xs text-accent font-medium mt-1">
              {service.tagline}
            </p>

            <!-- Descripción detallada -->
            <p class="mt-4 text-xs sm:text-sm text-light/70 leading-relaxed">
              {service.description}
            </p>

            <!-- Separador sutil -->
            <div class="w-full h-px bg-quaternary my-6"></div>

            <!-- Lista de Características Incluidas -->
            <ul class="space-y-2.5 text-xs text-light/80">
              {service.features.map((feature) => (
                <li class="flex items-start gap-2.5">
                  <span class="p-0.5 bg-accent/15 text-accent mt-0.5 shrink-0">
                    <Check class="w-3 h-3 text-accent" />
                  </span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Pie de Tarjeta: Precio y CTA  -->
          <div class="mt-8 pt-6 border-t border-quaternary flex items-center justify-between gap-4">
            <div>
              <span class="text-[10px] uppercase font-bold tracking-widest text-light/50 block font-mono">Costo</span>
              <div class="flex items-baseline gap-1">
                <span class="font-heading text-3xl font-black text-light font-mono">${service.price}</span>
                <span class="text-xs text-light/60 font-medium ml-1">MX</span>
              </div>
            </div>

            <a
              href={`#contacto?servicio=${encodeURIComponent(service.id)}`}
              class={`inline-flex items-center gap-2 px-5 py-2.5 text-xs font-bold uppercase tracking-widest transition-all duration-200 ${
                service.popular
                  ? 'bg-accent text-dark hover:bg-accent-dark shadow-md'
                  : 'bg-dark border border-quaternary text-light hover:text-accent hover:border-accent'
              }`}
            >
              <span>Elegir</span>
              <ArrowRight class="w-3.5 h-3.5" />
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- CTA consulta -->
    <div class="mt-16 flex items-center bg-dark p-6">
      

      <a
        href="#contacto"
        class="mx-auto shrink-0 inline-flex items-center gap-2 px-6 py-3 text-xs font-bold uppercase tracking-widest bg-accent text-dark hover:bg-accent-dark transition-colors"
      >
        <span>Agendar Consulta</span>
        <ArrowRight class="w-3.5 h-3.5" />
      </a>
    </div>

  </div>
</section>
